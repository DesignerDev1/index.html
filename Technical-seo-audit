    <script>
        // Set dynamic copyright year
      document.getElementById('yearSpan').textContent = new Date().getFullYear();
        // Main Audit Engine Simulation and Real Signal Analyzer
        async function runAudit(e) {
            e.preventDefault();            
            const rawUrl = document.getElementById('targetUrl').value.trim();
            const email = document.getElementById('targetEmail').value.trim();       
            if (!rawUrl || !email) return;
            // Normalize URL
            let targetUrl = rawUrl;
            if (!/^https?:\/\//i.test(targetUrl)) {
                targetUrl = 'https://' + targetUrl;
            }
            // UI State updates
            document.getElementById('loadingSection').classList.remove('hidden');
            document.getElementById('resultsSection').classList.add('hidden');
            document.getElementById('submitBtn').disabled = true;
            const progressBar = document.getElementById('progressBar');
            const statusText = document.getElementById('loadingStatusText');     
            // Step 1: Initializing Connection
            progressBar.style.width = '25%';
            statusText.textContent = 'Initiating Remote Signal Check...';
            await sleep(600);
            // Step 2: Parsing Schema & Viewport
            progressBar.style.width = '55%';
            statusText.textContent = 'Evaluating Structured Data & Mobile Indexing...';
            await sleep(700);
            // Step 3: XML & Meta verification
            progressBar.style.width = '85%';
            statusText.textContent = 'Checking XML Architecture & Open Graph...';
            await sleep(600);
            // Step 4: Finalizing Score Calculation
            progressBar.style.width = '100%';
            statusText.textContent = 'Generating Teaser Audit Report...';
            await sleep(400);
            // Hide Loading, Show Results
            document.getElementById('loadingSection').classList.add('hidden');
            document.getElementById('resultsSection').classList.remove('hidden');
            document.getElementById('submitBtn').disabled = false;
            // Populate Report Header
            document.getElementById('displayUrl').textContent = targetUrl;
            document.getElementById('displayEmail').textContent = email;
            document.getElementById('leadAuditUrl').value = targetUrl;
            document.getElementById('leadEmailInput').value = email;
            // Calculate Deterministic Score based on domain length and structure
            const auditData = generateAuditResults(targetUrl);
            document.getElementById('leadAuditScore').value = auditData.overallScore;
            // Animate Score Ring & Number
            animateScoreGauge(auditData.overallScore);
            renderIssueTeasers(auditData);
            // Scroll to results cleanly
            document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth' });
        }
        // Helper sleep function
        function sleep(ms) {
            return new Promise(resolve => setTimeout(resolve, ms));
        }
        // Generate Audit Results & Specific Issues
        function generateAuditResults(url) {
            // Seeded calculation for reproducible results per domain
            let hash = 0;
            for (let i = 0; i < url.length; i++) {
                hash = url.charCodeAt(i) + ((hash << 5) - hash);
            }
            const positiveHash = Math.abs(hash);
            const schemaScore = 50 + (positiveHash % 45); // 50 - 95
            const mobileScore = 70 + (positiveHash % 28); // 70 - 98
            const xmlScore = 40 + (positiveHash % 50);    // 40 - 90
            const metaScore = 55 + (positiveHash % 40);   // 55 - 95
            const overallScore = Math.round((schemaScore + mobileScore + xmlScore + metaScore) / 4);
            return {
                overallScore,
                schemaScore,
                mobileScore,
                xmlScore,
                metaScore
            };
        }
        // Animate SVG gauge and text
        function animateScoreGauge(score) {
            const circle = document.getElementById('scoreRing');
            const scoreDisplay = document.getElementById('scoreDisplay');
            const gradeText = document.getElementById('scoreGradeText');            
            // SVG Circle Circumference r=40 is 2 * PI * 40 ≈ 251.2
            const circumference = 251.2;
            const offset = circumference - (score / 100) * circumference;         
            circle.style.strokeDashoffset = offset;
            // Animate number count up
            let current = 0;
            const duration = 1000;
            const stepTime = 15;
            const steps = duration / stepTime;
            const increment = score / steps;
            const timer = setInterval(() => {
                current += increment;
                if (current >= score) {
                    current = score;
                    clearInterval(timer);
                }
                scoreDisplay.textContent = Math.round(current);
            }, stepTime);
            // Set Grade Text & Color
            if (score >= 85) {
                circle.setAttribute('class', 'progress-ring-circle text-brand-400');
                gradeText.textContent = 'Excellent technical foundation. Minor schema optimizations needed.';
            } else if (score >= 65) {
                circle.setAttribute('class', 'progress-ring-circle text-yellow-400');
                gradeText.textContent = 'Moderate technical issues detected. Action recommended.';
            } else {
                circle.setAttribute('class', 'progress-ring-circle text-red-400');
                gradeText.textContent = 'Critical technical errors found impacting organic search indexing.';
            }
        }
        // Render Issue Teasers in List
        function renderIssueTeasers(data) {
            const container = document.getElementById('issuesList');
            container.innerHTML = '';
            const issues = [
                {
                    category: 'Structured Data',
                    title: 'JSON-LD Organization Schema Missing or Incomplete',
                    severity: data.schemaScore < 70 ? 'high' : 'medium',
                    desc: 'Google AI & SGE requires structured JSON-LD data to accurately index business entity attributes.'
                },
                {
                    category: 'XML Architecture',
                    title: 'Robots.txt Crawl Directive Optimizations Found',
                    severity: data.xmlScore < 60 ? 'high' : 'low',
                    desc: 'Important asset files are not explicitly declared in sitemap.xml endpoints.'
                },
                {
                    category: 'Mobile Indexing',
                    title: 'Touch Target & Viewport Optimization',
                    severity: data.mobileScore < 80 ? 'medium' : 'passed',
                    desc: 'Mobile-first indexing compliance requires tap targets to maintain a minimum padding of 48px.'
                },
                {
                    category: 'Metadata',
                    title: 'Open Graph (OG) Social Tags & Meta Length Check',
                    severity: data.metaScore < 75 ? 'medium' : 'low',
                    desc: 'Meta description character length exceeds recommended viewport constraints.'
                }
            ];
            issues.forEach(issue => {
                let badgeClass = 'bg-yellow-500/10 text-yellow-400 border-yellow-500/30';
                let icon = 'fa-triangle-exclamation';
                if (issue.severity === 'high') {
                    badgeClass = 'bg-red-500/10 text-red-400 border-red-500/30';
                    icon = 'fa-circle-xmark';
                } else if (issue.severity === 'passed') {
                    badgeClass = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30';
                    icon = 'fa-circle-check';
                }
                const itemHTML = `
                    <div class="p-4 rounded-xl bg-dark-bg border border-dark-border flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div class="flex items-start gap-3">
                            <i class="fa-solid ${icon} mt-1 text-sm ${issue.severity === 'high' ? 'text-red-400' : issue.severity === 'passed' ? 'text-brand-400' : 'text-yellow-400'}"></i>
                            <div>
                                <h5 class="text-sm font-semibold text-white">${issue.title}</h5>
                                <p class="text-xs text-gray-400 mt-0.5">${issue.desc}</p>
                            </div>
                        </div>
                        <span class="px-2.5 py-1 rounded text-xs font-semibold border ${badgeClass} self-start sm:self-center uppercase tracking-wider shrink-0">
                            ${issue.category}
                        </span>
                    </div>
                `;
                container.innerHTML += itemHTML;
            });
        }
        // Lead Form Handling Integration (Web3Forms / Formspree / Webhook)
        async function submitLeadForm(e) {
            e.preventDefault();            
            const email = document.getElementById('leadEmailInput').value;
            const url = document.getElementById('leadAuditUrl').value;
            const score = document.getElementById('leadAuditScore').value;
            const btn = document.getElementById('leadSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = `<i class="fa-solid fa-spinner animate-spin"></i> Dispatching...`;
            try {
                // Endpoint integration template: Replace with Formspree, Web3Forms, or custom endpoint
                // Defaulting to Formspree endpoint format targeting oasdev001@gmail.com
                const response = await fetch('https://formspree.io/f/oasdev001@gmail.com', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        email: email,
                        audited_url: url,
                        score: score,
                        message: `New Lead from SEO Teaser Tool for ${url} (Score: ${score}/100)`
                    })
                }).catch(() => null); // Graceful fallback if Formspree unconfigured
                // Display success response regardless to maintain optimal UX     
              document.getElementById('leadSuccessMsg').classList.remove('hidden');
                btn.innerHTML = `<i class="fa-solid fa-check"></i> Dispatched!`;
            } catch (err) {
                console.error(err);
                document.getElementById('leadSuccessMsg').classList.remove('hidden');
                btn.innerHTML = `<i class="fa-solid fa-check"></i> Report Sent`;
            }
        }
    </script>
